<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/grey"
        android:layout_weight="1">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/colorPrimary">
            <TextView
                android:id="@+id/trader_header_textview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="15dp"
                android:text="@string/add_order"
                android:background="@color/colorPrimary"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:gravity="center"/>


            <ImageButton
                android:id="@+id/dialog_add_order_delete_img_btn"
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:background="@color/colorPrimary"
                android:src="@drawable/delete_icon"
                android:layout_alignParentRight="true"
                android:layout_weight="1">

            </ImageButton>

        </RelativeLayout>


        <TextView
            android:id="@+id/dialog_order_message_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textColor="@color/colorPrimaryDark"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            >
            <TextView
                android:id="@+id/order_name_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="3dp"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16sp"
                android:layout_alignParentTop="true"
                android:text="@string/name"/>
            <EditText
                android:id="@+id/order_name_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:nextFocusDown="@+id/order_item_edit"
                android:paddingTop="0dp"
                android:textSize="12sp"
                android:focusable="false"
                android:layout_below="@+id/order_name_textview"
                android:hint="@string/select_name_input"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            >
            <TextView
                android:id="@+id/order_item_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="3dp"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16sp"
                android:layout_alignParentTop="true"
                android:text="@string/item"/>
            <EditText
                android:id="@+id/order_item_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:nextFocusDown="@+id/order_box_edit"
                android:inputType="text"
                android:paddingTop="0dp"
                android:textSize="12sp"
                android:focusable="false"
                android:layout_below="@+id/order_item_textview"
                android:hint="@string/select_item_input"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/order_box_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="3dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16sp"
                    android:layout_alignParentTop="true"
                    android:text="@string/total_box"/>
                <EditText
                    android:id="@+id/order_box_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:nextFocusDown="@+id/order_kgs_edit"
                    android:inputType="number"
                    android:paddingTop="0dp"
                    android:textSize="12sp"
                    android:layout_below="@+id/order_box_textview"
                    android:hint="@string/enter_box"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/order_kgs_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="3dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16sp"
                    android:layout_alignParentTop="true"
                    android:text="@string/total_kg"/>
                <EditText
                    android:id="@+id/order_kgs_edit"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="0dp"
                    android:nextFocusDown="@+id/order_rate_edit"
                    android:textSize="12sp"
                    android:layout_below="@+id/order_kgs_textview"
                    android:hint="@string/enter_kgs"/>
            </RelativeLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/order_rate_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="3dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16sp"
                    android:layout_alignParentTop="true"
                    android:text="@string/rate"/>
                <EditText
                    android:id="@+id/order_rate_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:nextFocusDown="@+id/order_date_edit"
                    android:inputType="numberDecimal"
                    android:paddingTop="0dp"
                    android:textSize="12sp"
                    android:layout_below="@+id/order_rate_textview"
                    android:hint="@string/enter_rate"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/order_date_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="3dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16sp"
                    android:layout_alignParentTop="true"
                    android:text="@string/date"/>
                <EditText
                    android:id="@+id/order_date_edit"
                    android:importantForAutofill="no"
                    android:inputType="date"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="0dp"
                    android:textSize="12sp"
                    android:layout_below="@+id/order_date_textview"
                    android:hint="@string/enter_date"/>
            </RelativeLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                android:id="@+id/order_dialog_cancel_btn"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/cancel_btn_bg"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="10dp"
                android:layout_marginRight="10dp"
                android:textSize="10dp"
                android:layout_marginLeft="20dp"
                android:layout_weight="1"
                android:text="@string/cancel_btn_text"/>
            <Button
                android:id="@+id/order_dialog_ok_btn"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:textSize="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/bg_screen_shape_roundness"
                android:textColor="@color/white"
                android:paddingBottom="10dp"
                android:text="@string/ok_btn_text"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>