<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/grey"
        android:layout_weight="1">
        <TextView
            android:id="@+id/trader_header_textview"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textSize="15dp"
            android:text="@string/add_order"

            android:background="@color/colorPrimary"
            android:textColor="@color/white"
            android:gravity="center"/>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/from_date"
                    android:gravity="center"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/to_date"
                    android:gravity="center"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/bill_add_order_calender_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_arrow_left_30"
                    android:background="@drawable/roundcorner"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:layout_weight="1.1"/>

                <EditText
                    android:id="@+id/bill_add_order_calender_from_date_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/search_bg"
                    android:focusable="false"
                    android:layout_weight="1"
                    android:hint="@string/from_date"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:textSize="14dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    />
                <ImageButton
                    android:id="@+id/bill_add_order_calender_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:src="@drawable/baseline_arrow_right_30"
                    android:background="@drawable/roundcorner"
                    android:layout_gravity="center"
                    android:layout_weight="1.1"/>


                <EditText
                    android:id="@+id/bill_add_order_calender_to_date_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/search_bg"
                    android:hint="@string/to_date"
                    android:paddingBottom="10dp"
                    android:textSize="14dp"
                    android:gravity="center"
                    android:focusable="false"
                    android:layout_weight="1"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_weight=".95"
                    android:text="@string/date"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:text="@string/breed"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_weight="1.1"
                    android:text="@string/box"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:layout_gravity="center"
                    android:layout_weight="1.1"
                    android:text="@string/kg"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:layout_gravity="center"
                    android:layout_weight="1.05"
                    android:text="@string/rate"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/bill_add_order_select_all_imageview"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:visibility="invisible"
                        android:src="@drawable/baseline_check_box_outline_blank_30"

                        />

                </RelativeLayout>




            </LinearLayout>
<!--           <ScrollView-->
<!--               android:layout_width="match_parent"-->
<!--               android:layout_height="match_parent">-->
           <ListView
               android:id="@+id/bill_generate_order_list"
               android:layout_width="match_parent"
               android:background="@color/white"
               android:layout_height="300dp"/>
<!--           </ScrollView>-->

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"

            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                android:id="@+id/bill_generate_add_dialog_cancel_btn"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/cancel_btn_bg"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="10dp"
                android:layout_marginRight="10dp"
                android:textSize="10dp"
                android:layout_marginLeft="20dp"
                android:layout_weight="1"
                android:text="@string/cancel_btn_text"/>
            <Button
                android:id="@+id/bill_generate_add_dialog_ok_btn"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:textSize="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/bg_screen_shape_roundness"
                android:textColor="@color/white"
                android:paddingBottom="10dp"
                android:text="@string/ok_btn_text"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>